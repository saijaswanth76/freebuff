# ---------------------------------------------------------------------------
# Community Food Donation and Distribution System - backend configuration
# Copy this file to `.env` (same folder) and replace the placeholder values.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# MongoDB connection string.
#  - Local MongoDB : mongodb://127.0.0.1:27017/community_food_system
#  - MongoDB Atlas : mongodb+srv://USER:PASSWORD@cluster.mongodb.net/community_food_system
# If you leave this EMPTY, the server starts a temporary in-memory MongoDB
# (development/demo only - all data disappears when the server stops).
MONGODB_URI=

# Secret used to sign JWT access tokens.
# Use a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# How long a login session stays valid (default: 1 day)
JWT_EXPIRES_IN=1d

# Name of the httpOnly session cookie
JWT_COOKIE_NAME=cfds_token

# Comma separated list of frontends allowed to call the API with credentials
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set to true to require admin verification before an NGO can accept donations
NGO_REQUIRE_VERIFICATION=false

# Optional: global API rate limit per 15 minutes (default 600)
API_RATE_LIMIT=600

# Optional: max size of uploaded food images in bytes (default 2 MB)
MAX_UPLOAD_SIZE_BYTES=2097152

# development | production | test
NODE_ENV=development
