# ---------------------------------------------------------------------------
# Community Food Donation and Distribution System - frontend configuration
# Copy this file to `.env` in the client folder:   copy .env.example .env
# ---------------------------------------------------------------------------

# Base URL of the Express API.
#
# Option A: leave it EMPTY to use the local development proxy.
#   The Vite dev server proxies /api and /uploads to http://localhost:5000,
#   so the browser only talks to one origin and httpOnly cookies just work.
#
# Option B: set an absolute URL to call the API directly on another origin.
#   The backend must then list this frontend in CLIENT_ORIGINS (CORS).
#
# If this variable is omitted entirely, the client defaults to the deployed API.
VITE_API_BASE_URL=https://food-donation-34al.onrender.com
