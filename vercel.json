{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm --prefix client install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://food-donation-34al.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://food-donation-34al.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}

